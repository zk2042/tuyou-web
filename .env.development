# 开发环境 development
# 配置文档参考 https://taro-docs.jd.com/docs/env-mode-config
# TARO_APP_ENV: 定义当前应用运行环境，development 表示开发环境，用于区分生产/测试等不同环境配置
TARO_APP_ENV=development
# TARO_APP_ID: 应用唯一标识ID，当前为空，通常用于平台识别或统计分析
TARO_APP_ID=
# TARO_APP_SITE_NAME: 站点名称标识，tuyou-dev 表示这是途游项目的开发环境站点
TARO_APP_SITE_NAME=tuyou-dev
# TARO_APP_API_BASE: API 接口基础地址，指向本地开发服务器 IP 和端口
TARO_APP_API_BASE=http://192.168.10.7:84/api/v1
# TARO_APP_ASSET_BASE: 静态资源基础路径，当前为空表示使用相对路径或默认配置
TARO_APP_ASSET_BASE=
# TARO_APP_LOG_LEVEL: 日志输出级别，debug 表示输出详细调试信息便于开发排查问题
TARO_APP_LOG_LEVEL=debug
# TARO_APP_USE_MOCK: 是否启用 Mock 数据，true 表示启用，请求会返回模拟数据
# 后台就绪后改为 false 即可切换到真实接口
TARO_APP_USE_MOCK=false