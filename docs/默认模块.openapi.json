                          "type": "string",
                          "enum": [
                            "徒步",
                            "露营",
                            "骑行",
                            "登山",
                            "跑步",
                            "攀岩",
                            "溯溪"
                          ],
                          "description": "活动类型，来源: activity_type"
                        },
                        "address": {
                          "type": "string",
                          "description": "活动地点"
                        },
                        "activityContent": {
                          "type": "string",
                          "description": "活动详情正文，来源: activity_content"
                        },
                        "startTime": {
                          "type": "string",
                          "description": "开始时间，来源: start_time"
                        },
                        "endTime": {
                          "type": "string",
                          "description": "结束时间，来源: end_time"
                        },
                        "signUpStart": {
                          "type": "string",
                          "description": "报名开始时间（后端自动计算=创建时间），格式 YYYY-MM-DD HH:mm:ss"
                        },
                        "signUpEnd": {
                          "type": "string",
                          "description": "报名截止时间（后端自动计算=开始时间-48h），格式 YYYY-MM-DD HH:mm:ss"
                        },
                        "maxPeople": {
                          "type": "integer",
                          "format": "int64",
                          "description": "人数上限，来源: max_people"
                        },
                        "currentPeople": {
                          "type": "integer",
                          "format": "int64",
                          "description": "当前报名人数，来源: current_people"
                        },
                        "price": {
                          "type": "number",
                          "minimum": 0,
                          "description": "费用，0=免费，来源: price"
                        },
                        "difficulty": {
                          "type": "string",
                          "enum": [
                            "入门",
                            "中等",
                            "中高等",
                            "高等"
                          ],
                          "description": "难度等级，来源: difficulty"
                        },
                        "joined": {
                          "type": "boolean",
                          "description": "当前用户是否已报名"
                        },
                        "members": {
                          "type": "array",
                          "items": {
                            "type": "object",
                            "properties": {
                              "id": {
                                "type": "string",
                                "description": "成员ID"
                              },
                              "nickname": {
                                "type": "string",
                                "description": "成员昵称"
                              },
                              "avatar": {
                                "type": "string",
                                "description": "成员头像URL"
                              }
                            },
                            "required": [
                              "id",
                              "nickname",
                              "avatar"
                            ]
                          },
                          "description": "已报名成员列表（含领队）"
                        }
                      },
                      "required": [
                        "id",
                        "leader",
                        "title",
                        "coverImg",
                        "activityType",
                        "address",
                        "activityContent",
                        "startTime",
                        "endTime",
                        "signUpStart",
                        "signUpEnd",
                        "maxPeople",
                        "currentPeople",
                        "price",
                        "difficulty",
                        "joined",
                        "members"
                      ]
                    }
                  },
                  "required": [
                    "code",
                    "message",
                    "data"
                  ]
                }
              }
            },
            "headers": {}
          }
        },
        "security": [
          {
            "bearer": []
          }
        ]
