# 生产环境 production
# 当前环境标识：production 表示生产环境，用于区分开发/测试/生产等不同运行环境
TARO_APP_ENV=production
// 微信小程序 AppID：生产环境的小程序唯一标识，需在小程序后台获取并配置
TARO_APP_ID=
// 站点名称标识：用于区分不同环境的站点配置，prod 表示生产环境
TARO_APP_SITE_NAME=tuyou-prod
// API 基础地址：后端接口服务的基础 URL，生产环境使用内网服务器地址
TARO_APP_API_BASE=http://192.168.10.7:84/api/v1
// 静态资源基础地址：用于配置 CDN 或静态资源服务器地址，当前为空表示使用相对路径
TARO_APP_ASSET_BASE=
# TARO_APP_USE_MOCK: 是否启用 Mock 数据，生产环境应关闭使用真实接口
TARO_APP_USE_MOCK=false
// 日志级别：warn 表示只输出警告及以上级别的日志，减少生产环境日志输出量
TARO_APP_LOG_LEVEL=warn


